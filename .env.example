# Copy to .env (never commit it). Read by docker-compose.prod.yml and by the backend.

# ---- domain -------------------------------------------------------------------------------
SITE_ADDRESS=shashguru.example.com

# ---- database -----------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ---- BYOK key encryption (REQUIRED) -------------------------------------------------------
# Generate (from backend/):  python -c "from app.services.crypto import generate_key; print('v1:' + generate_key())"
# To rotate: put the new key FIRST:  v2:<new>,v1:<old>   (old keys stay readable)
KEY_ENCRYPTION_KEYS=

# ---- authentication (pluggable: clerk | oidc) ---------------------------------------------
AUTH_PROVIDER=clerk
# Clerk: the Frontend API URL of your instance, e.g. https://clerk.shashguru.example.com
AUTH_ISSUER=
# Comma separated provider user ids that are administrators
AUTH_ADMIN_SUBJECTS=
# Clerk webhook signing secret (whsec_...) for POST /backend/api/v1/webhooks/auth (optional, recommended)
AUTH_WEBHOOK_SECRET=
# Clerk secret key (sk_live_...): only used to erase users at Clerk when they delete their account
AUTH_SECRET_KEY=
# Baked into the frontend at build time (public values)
VITE_AUTH_PROVIDER=clerk
VITE_CLERK_PUBLISHABLE_KEY=

# ---- payments (pluggable: stripe | none) --------------------------------------------------
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<domain>/backend/api/v1/webhooks/payments
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# ---- managed LLMs (the platform keys; a model is offered only if its key is set) -----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Customer price = provider price x this. 1 credit = 0.001 USD of customer price.
CREDIT_MARKUP=1.5

# ---- tuning -------------------------------------------------------------------------------
ENGINE_POOL_SIZE=4
# Per-minute limits (per IP when anonymous, per user otherwise)
RATE_ENGINE_ANON_PER_MIN=60
RATE_ENGINE_USER_PER_MIN=180
RATE_GAME_ANON_PER_MIN=4
RATE_GAME_USER_PER_MIN=12
RATE_LLM_PER_MIN=15
